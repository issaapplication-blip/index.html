# Keep every text file LF in the repository, so what we test locally is
# exactly what GitHub and Render serve. CRLF is only added on Windows checkouts.
* text=auto eol=lf

*.html        text eol=lf
*.js          text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf
*.css         text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.txt         text eol=lf
*.md          text eol=lf
*.sql         text eol=lf
*.webmanifest text eol=lf

*.png binary
*.jpg binary
*.ico binary
